{
  "extends": [
    "config:base",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": [
        "**"
      ],
      "allowedVersions": "!/\\-SNAPSHOT$/"
    },
    {
      "description": "OpenRewrite 7.40.0 and 7.41.0 require the unpublished rewrite-bom 8.91.0.",
      "matchPackageNames": [
        "org.openrewrite:plugin"
      ],
      "allowedVersions": "!/^7\\.(40|41)\\.0$/"
    }
  ]
}
